name: ci

# CI (pull-request validation): fast feedback on every change, before it can reach main.
# Keep this fast — lint/build/test only, no deployment artifacts. See docs/workflow/
# 08-deployment.md for the separate trunk-deployment pipeline (deploy.yml), which is the
# only workflow allowed to touch production and only runs after this one has passed on
# main.

on:
  pull_request:
  push:
    branches-ignore: [main]

permissions:
  contents: read

jobs:
  ci:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          # Full history (not the default shallow clone) so `validate`'s
          # passing_is_monotonic check can diff feature_list.json against
          # the PR base ref — a shallow checkout would have no base ref to
          # compare against, silently defeating that check.
          fetch-depth: 0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: 24
      - run: npx sdlc-harness validate
      # This step intentionally fails until the real lint/type-check/test/build
      # commands for {{projectName}} are wired in below — a CI workflow that can
      # go green without ever running a real check is worse than no CI at all.
      - name: Project verification (placeholder — must be replaced)
        run: |
          echo "Project verification command is not configured." >&2
          echo "Replace this step with real lint/type-check/test/build commands for {{projectName}}." >&2
          exit 1
