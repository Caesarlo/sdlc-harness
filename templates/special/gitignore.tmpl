# sdlc-harness: most of .harness/ is tracked on purpose — events/ (the
# audit log) and claim/lease data (embedded directly in feature_list.json)
# need to sync across machines for team collaboration. Only the derived
# local cache is safe to ignore; it's regenerated by `sdlc-harness validate`
# and is never a source of truth.
.harness/last-validated-features.json

# Worktree working directories created by `sdlc-harness workspace create`.
# The branches themselves are ordinary git refs and sync normally; only the
# local checkout paths are excluded here.
.worktrees/

node_modules/
