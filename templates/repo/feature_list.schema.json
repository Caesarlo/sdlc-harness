{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sdlc-harness feature_list.json",
  "type": "object",
  "required": ["project", "schema_version", "milestones", "features"],
  "properties": {
    "project": { "type": "string" },
    "schema_version": { "type": "string" },
    "last_updated": { "type": "string" },
    "rules": {
      "type": "object",
      "properties": {
        "single_active_feature": { "type": "boolean" },
        "passing_requires_evidence": { "type": "boolean" },
        "do_not_skip_verification": { "type": "boolean" },
        "feature_should_fit_one_session": { "type": "boolean" },
        "passing_is_monotonic": { "type": "boolean" }
      }
    },
    "rule_exceptions": { "type": "object" },
    "status_legend": { "type": "object" },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "objective"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "objective": { "type": "string" }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "milestone", "behavior", "status", "dependencies", "verification"],
        "properties": {
          "id": { "type": "string" },
          "milestone": { "type": "string" },
          "area": { "type": "string" },
          "title": { "type": "string" },
          "behavior": { "type": "string" },
          "status": { "enum": ["not_started", "in_progress", "blocked", "passing"] },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "verification": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "command", "expected"],
              "properties": {
                "type": { "type": "string" },
                "command": { "type": "string" },
                "expected": { "type": "string" }
              }
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "result", "recorded_at"],
              "properties": {
                "kind": { "type": "string" },
                "command": { "type": "string" },
                "result": { "type": "string" },
                "recorded_at": { "type": "string" }
              }
            }
          },
          "source_refs": { "type": "array", "items": { "type": "string" } },
          "implementation": {
            "type": "object",
            "properties": {
              "files": { "type": "array", "items": { "type": "string" } },
              "commits": { "type": "array", "items": { "type": "string" } }
            }
          },
          "blocker": { "type": ["string", "null"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
